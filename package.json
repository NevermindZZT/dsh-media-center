{
  "name": "dsh-media-center",
  "version": "1.1.0",
  "type": "module",
  "description": "DSH 媒体中心：面向 DeepSeek Harness 的本地视频 / 音乐 / 剪辑项目管理插件，含故事板分镜、本地 DSP 音乐卡点与工程导出",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "media",
    "video",
    "music",
    "ffmpeg",
    "bpm",
    "storyboard"
  ],
  "license": "MIT",
  "author": "NevermindZZT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NevermindZZT/dsh-media-center.git"
  },
  "homepage": "https://github.com/NevermindZZT/dsh-media-center#readme",
  "bugs": {
    "url": "https://github.com/NevermindZZT/dsh-media-center/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "docs/**/*.md",
    "src/**/*.js",
    "src/**/*.py"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
